; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - The Matrix (1999) (light)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\matrix-light.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Light
AppMode=Light

[Control Panel\Colors]
Background=237 247 239
Window=237 247 239
WindowText=16 35 24
Hilight=22 143 77
HilightText=237 247 239
ButtonFace=219 230 222
ButtonText=16 35 24
GrayText=169 197 174
ActiveTitle=22 143 77
TitleText=237 247 239
InactiveTitle=197 209 200
InactiveTitleText=169 197 174
MenuText=16 35 24
InfoText=16 35 24
InfoWindow=226 236 228
WindowFrame=171 183 174
Scrollbar=210 222 213
AppWorkspace=215 226 218

[MasterThemeSelector]
MTSM=DABJDKT
