Windows Registry Editor Version 5.00

; Neon Mary - Amélie (2001) (light)
; Generated by generate_windows.py -- do not edit by hand.
;
; Sets the Windows 11 accent colour and light/dark mode. Both are
; supported, per-user (HKCU) and fully reversible -- no OS patching.
; Sign out and back in, or restart Explorer, for the taskbar to pick
; up the new accent.
;
; accent ramp (dark -> light): #4a190f #652315 #812c1b #9c3620 #b83f26 #ca6f5c #dc9f92 #edcfc9

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Accent]
"AccentPalette"=hex:0f,19,4a,00,15,23,65,00,1b,2c,81,00,20,36,9c,00,26,3f,b8,00,5c,6f,ca,00,\
  92,9f,dc,00,c9,cf,ed,00
"StartColorMenu"=dword:ff263fb8
"AccentColorMenu"=dword:ff263fb8

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize]
"AppsUseLightTheme"=dword:00000001
"SystemUsesLightTheme"=dword:00000001
"ColorPrevalence"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\DWM]
"AccentColor"=dword:ff263fb8
"ColorizationColor"=dword:ff263fb8
"ColorizationAfterglow"=dword:ff263fb8
"ColorPrevalence"=dword:00000001
