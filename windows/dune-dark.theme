; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Dune (2021) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\dune-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=16 25 26
Window=16 25 26
WindowText=244 234 211
Hilight=216 138 61
HilightText=244 234 211
ButtonFace=34 42 41
ButtonText=244 234 211
GrayText=37 53 54
ActiveTitle=216 138 61
TitleText=244 234 211
InactiveTitle=57 63 59
InactiveTitleText=37 53 54
MenuText=244 234 211
InfoText=244 234 211
InfoWindow=27 35 35
WindowFrame=84 88 82
Scrollbar=43 50 48
AppWorkspace=39 46 44

[MasterThemeSelector]
MTSM=DABJDKT
