; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Blade Runner (light)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\blade-runner-light.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Light
AppMode=Light

[Control Panel\Colors]
Background=243 247 248
Window=243 247 248
WindowText=16 24 34
Hilight=0 127 153
HilightText=243 247 248
ButtonFace=225 229 231
ButtonText=16 24 34
GrayText=113 129 140
ActiveTitle=0 127 153
TitleText=243 247 248
InactiveTitle=202 207 209
InactiveTitleText=113 129 140
MenuText=16 24 34
InfoText=16 24 34
InfoWindow=232 236 237
WindowFrame=175 180 184
Scrollbar=216 220 222
AppWorkspace=220 225 227

[MasterThemeSelector]
MTSM=DABJDKT
