; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Suspiria (1977) (light)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\suspiria-light.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Light
AppMode=Light

[Control Panel\Colors]
Background=255 244 223
Window=255 244 223
WindowText=36 17 22
Hilight=165 31 60
HilightText=255 244 223
ButtonFace=237 226 207
ButtonText=36 17 22
GrayText=178 143 141
ActiveTitle=165 31 60
TitleText=255 244 223
InactiveTitle=216 203 187
InactiveTitleText=178 143 141
MenuText=36 17 22
InfoText=36 17 22
InfoWindow=244 233 213
WindowFrame=189 176 163
Scrollbar=229 217 199
AppWorkspace=233 221 203

[MasterThemeSelector]
MTSM=DABJDKT
