; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - The Grand Budapest Hotel (2014) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\grand-budapest-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=34 22 26
Window=34 22 26
WindowText=247 228 230
Hilight=241 167 190
HilightText=247 228 230
ButtonFace=51 38 42
ButtonText=247 228 230
GrayText=90 63 71
ActiveTitle=241 167 190
TitleText=247 228 230
InactiveTitle=72 59 63
InactiveTitleText=90 63 71
MenuText=247 228 230
InfoText=247 228 230
InfoWindow=45 32 36
WindowFrame=98 84 87
Scrollbar=60 47 50
AppWorkspace=55 43 46

[MasterThemeSelector]
MTSM=DABJDKT
