; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - The Shining (1980) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\shining-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=16 13 13
Window=16 13 13
WindowText=243 238 224
Hilight=201 53 50
HilightText=243 238 224
ButtonFace=34 31 30
ButtonText=243 238 224
GrayText=51 35 34
ActiveTitle=201 53 50
TitleText=243 238 224
InactiveTitle=57 54 51
InactiveTitleText=51 35 34
MenuText=243 238 224
InfoText=243 238 224
InfoWindow=27 24 24
WindowFrame=84 80 76
Scrollbar=43 40 38
AppWorkspace=39 36 34

[MasterThemeSelector]
MTSM=DABJDKT
