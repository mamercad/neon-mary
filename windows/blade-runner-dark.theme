; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Blade Runner (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\blade-runner-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=10 12 18
Window=10 12 18
WindowText=234 252 255
Hilight=0 229 255
HilightText=234 252 255
ButtonFace=28 31 37
ButtonText=234 252 255
GrayText=74 85 104
ActiveTitle=0 229 255
TitleText=234 252 255
InactiveTitle=50 55 61
InactiveTitleText=74 85 104
MenuText=234 252 255
InfoText=234 252 255
InfoWindow=21 24 30
WindowFrame=77 84 89
Scrollbar=37 41 46
AppWorkspace=32 36 42

[MasterThemeSelector]
MTSM=DABJDKT
