; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Neon Genesis Evangelion (1995) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\evangelion-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=18 13 24
Window=18 13 24
WindowText=244 243 232
Hilight=169 118 195
HilightText=244 243 232
ButtonFace=36 31 41
ButtonText=244 243 232
GrayText=52 35 59
ActiveTitle=169 118 195
TitleText=244 243 232
InactiveTitle=59 54 61
InactiveTitleText=52 35 59
MenuText=244 243 232
InfoText=244 243 232
InfoWindow=29 24 34
WindowFrame=86 82 86
Scrollbar=45 41 49
AppWorkspace=41 36 45

[MasterThemeSelector]
MTSM=DABJDKT
