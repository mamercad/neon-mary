; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Solaris (1972) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\solaris-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=23 19 14
Window=23 19 14
WindowText=255 242 210
Hilight=215 168 75
HilightText=255 242 210
ButtonFace=42 37 30
ButtonText=255 242 210
GrayText=73 59 42
ActiveTitle=215 168 75
TitleText=255 242 210
InactiveTitle=65 59 49
InactiveTitleText=73 59 42
MenuText=255 242 210
InfoText=255 242 210
InfoWindow=35 30 24
WindowFrame=93 86 73
Scrollbar=51 46 38
AppWorkspace=46 41 34

[MasterThemeSelector]
MTSM=DABJDKT
