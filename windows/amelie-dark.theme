; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Amélie (2001) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\amelie-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=23 18 15
Window=23 18 15
WindowText=255 240 216
Hilight=217 91 50
HilightText=255 240 216
ButtonFace=42 36 31
ButtonText=255 240 216
GrayText=73 54 44
ActiveTitle=217 91 50
TitleText=255 240 216
InactiveTitle=65 58 51
InactiveTitleText=73 54 44
MenuText=255 240 216
InfoText=255 240 216
InfoWindow=35 29 25
WindowFrame=93 85 75
Scrollbar=51 45 39
AppWorkspace=46 40 35

[MasterThemeSelector]
MTSM=DABJDKT
