; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Dark City (1998) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\dark-city-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=8 9 13
Window=8 9 13
WindowText=231 237 242
Hilight=120 151 189
HilightText=231 237 242
ButtonFace=26 27 31
ButtonText=231 237 242
GrayText=38 42 50
ActiveTitle=120 151 189
TitleText=231 237 242
InactiveTitle=48 50 54
InactiveTitleText=38 42 50
MenuText=231 237 242
InfoText=231 237 242
InfoWindow=19 20 24
WindowFrame=75 77 82
Scrollbar=35 36 40
AppWorkspace=30 32 36

[MasterThemeSelector]
MTSM=DABJDKT
