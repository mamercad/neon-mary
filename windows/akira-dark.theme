; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Akira (1988) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\akira-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=8 13 20
Window=8 13 20
WindowText=245 238 226
Hilight=239 59 36
HilightText=245 238 226
ButtonFace=27 31 36
ButtonText=245 238 226
GrayText=24 35 51
ActiveTitle=239 59 36
TitleText=245 238 226
InactiveTitle=51 54 57
InactiveTitleText=24 35 51
MenuText=245 238 226
InfoText=245 238 226
InfoWindow=20 24 30
WindowFrame=79 80 82
Scrollbar=36 40 45
AppWorkspace=32 36 41

[MasterThemeSelector]
MTSM=DABJDKT
