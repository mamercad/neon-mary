; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - The Shining (1980) (light)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\shining-light.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Light
AppMode=Light

[Control Panel\Colors]
Background=243 238 227
Window=243 238 227
WindowText=36 28 27
Hilight=165 46 47
HilightText=243 238 227
ButtonFace=226 221 211
ButtonText=36 28 27
GrayText=184 170 160
ActiveTitle=165 46 47
TitleText=243 238 227
InactiveTitle=206 200 191
InactiveTitleText=184 170 160
MenuText=36 28 27
InfoText=36 28 27
InfoWindow=233 228 217
WindowFrame=181 175 167
Scrollbar=218 213 203
AppWorkspace=222 217 207

[MasterThemeSelector]
MTSM=DABJDKT
