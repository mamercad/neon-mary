; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - The Grand Budapest Hotel (2014) (light)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\grand-budapest-light.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Light
AppMode=Light

[Control Panel\Colors]
Background=253 240 242
Window=253 240 242
WindowText=58 34 40
Hilight=176 53 107
HilightText=253 240 242
ButtonFace=237 224 226
ButtonText=58 34 40
GrayText=138 107 118
ActiveTitle=176 53 107
TitleText=253 240 242
InactiveTitle=218 203 206
InactiveTitleText=138 107 118
MenuText=58 34 40
InfoText=58 34 40
InfoWindow=243 230 232
WindowFrame=194 178 181
Scrollbar=230 215 218
AppWorkspace=234 219 222

[MasterThemeSelector]
MTSM=DABJDKT
