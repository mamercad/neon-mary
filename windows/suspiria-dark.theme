; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - Suspiria (1977) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\suspiria-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=16 7 11
Window=16 7 11
WindowText=255 241 214
Hilight=227 59 66
HilightText=255 241 214
ButtonFace=35 26 27
ButtonText=255 241 214
GrayText=60 24 32
ActiveTitle=227 59 66
TitleText=255 241 214
InactiveTitle=59 49 48
InactiveTitleText=60 24 32
MenuText=255 241 214
InfoText=255 241 214
InfoWindow=28 19 21
WindowFrame=88 77 72
Scrollbar=45 35 35
AppWorkspace=40 30 31

[MasterThemeSelector]
MTSM=DABJDKT
