Windows Registry Editor Version 5.00

; Neon Mary - The Crow (1994) (dark)
; Generated by generate_windows.py -- do not edit by hand.
;
; Sets the Windows 11 accent colour and light/dark mode. Both are
; supported, per-user (HKCU) and fully reversible -- no OS patching.
; Sign out and back in, or restart Explorer, for the taskbar to pick
; up the new accent.
;
; accent ramp (dark -> light): #494250 #655b6f #80748d #9c8dab #b7a6c9 #c9bcd6 #dbd2e4 #ede9f2

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Accent]
"AccentPalette"=hex:50,42,49,00,6f,5b,65,00,8d,74,80,00,ab,8d,9c,00,c9,a6,b7,00,d6,bc,c9,00,\
  e4,d2,db,00,f2,e9,ed,00
"StartColorMenu"=dword:ffc9a6b7
"AccentColorMenu"=dword:ffc9a6b7

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize]
"AppsUseLightTheme"=dword:00000000
"SystemUsesLightTheme"=dword:00000000
"ColorPrevalence"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\DWM]
"AccentColor"=dword:ffc9a6b7
"ColorizationColor"=dword:ffc9a6b7
"ColorizationAfterglow"=dword:ffc9a6b7
"ColorPrevalence"=dword:00000001
