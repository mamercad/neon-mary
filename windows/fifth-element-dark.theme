; Neon Mary theme for Windows 11.
; Generated by generate_windows.py -- do not edit by hand.
;
; Install: place alongside its .jpg in
;   %LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\
; then double-click this file.
;
; NOTE: [Control Panel\Colors] below only affects classic and
; high-contrast surfaces. The modern Windows 11 shell ignores most of
; it -- the wallpaper, the light/dark mode and the accent colour are
; what actually change the look. Run apply-accent.ps1 for the accent.

[Theme]
DisplayName=Neon Mary - The Fifth Element (1997) (dark)

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\NeonMary\fifth-element-dark.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[Control Panel\Colors]
Background=16 11 22
Window=16 11 22
WindowText=255 240 222
Hilight=0 204 232
HilightText=255 240 222
ButtonFace=35 29 38
ButtonText=255 240 222
GrayText=56 37 62
ActiveTitle=0 204 232
TitleText=255 240 222
InactiveTitle=59 52 58
InactiveTitleText=56 37 62
MenuText=255 240 222
InfoText=255 240 222
InfoWindow=28 22 32
WindowFrame=88 80 82
Scrollbar=45 38 46
AppWorkspace=40 34 42

[MasterThemeSelector]
MTSM=DABJDKT
